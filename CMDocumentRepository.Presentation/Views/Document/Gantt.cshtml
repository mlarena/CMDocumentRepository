@model CMDocumentRepository.Application.DTOs.GanttDataDto
@{
    ViewData["Title"] = "Диаграмма Ганта";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-calendar-week me-2"></i>Диаграмма Ганта</h4>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Нет данных для отображения. Добавьте документы с датами действия (от/до).
    </div>
}
else
{
    <!-- Управление масштабом -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary gantt-zoom" data-view-mode="Day">Дни</button>
                    <button type="button" class="btn btn-outline-secondary gantt-zoom active" data-view-mode="Week">Недели</button>
                    <button type="button" class="btn btn-outline-secondary gantt-zoom" data-view-mode="Month">Месяцы</button>
                </div>
                <div class="ms-auto d-flex gap-2">
                    <span class="badge bg-danger">Крит</span>
                    <span class="badge bg-warning text-dark">Высокий</span>
                    <span class="badge bg-info">Средний</span>
                    <span class="badge bg-secondary">Низкий</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Контейнер для Gantt -->
    <div class="card">
        <div class="card-body">
            <div class="gantt-target"></div>
        </div>
    </div>
}

@section Scripts {
<script defer>
(function () {
    var tasks = @Html.Raw(Json.Serialize(Model.Items.Select(item => new {
        id = item.Id.ToString(),
        name = item.Name,
        start = item.Start.ToString("yyyy-MM-dd"),
        end = item.End.ToString("yyyy-MM-dd"),
        progress = item.Progress,
        color = item.Color,
        group = item.Group
    })));

    console.log('Tasks loaded:', tasks);
    console.log('Gantt object:', typeof Gantt);
    console.log('jQuery loaded:', typeof jQuery);

    $(document).ready(function () {
        console.log('jQuery ready');
        console.log('Gantt-target element:', $('.gantt-target').length);
        
        if (typeof Gantt === 'undefined') {
            console.error('Frappe Gantt library not loaded!');
            $('.gantt-target').html('<div class="alert alert-danger">Ошибка: библиотека Frappe Gantt не загрузилась</div>');
            return;
        }

        try {
            var gantt = new Gantt(".gantt-target", tasks, {
                header_height: 50,
                column_width: 30,
                step: 24,
                view_modes: ['Day', 'Week', 'Month'],
                bar_height: 25,
                bar_corner_radius: 3,
                arrow_curve: 5,
                padding: 18,
                view_mode: 'Week',
                date_format: 'YYYY-MM-DD',
                custom_popup: false,
                language: 'ru'
            });
            console.log('Gantt initialized successfully');

            // Обработчики кнопок масштаба
            $('.gantt-zoom').on('click', function () {
                $('.gantt-zoom').removeClass('active btn-outline-primary').addClass('btn-outline-secondary');
                $(this).addClass('active btn-outline-primary').removeClass('btn-outline-secondary');
                var viewMode = $(this).data('view-mode');
                gantt.change_view_mode(viewMode);
            });
        } catch (e) {
            console.error('Error initializing Gantt:', e);
            $('.gantt-target').html('<div class="alert alert-danger">Ошибка инициализации: ' + e.message + '</div>');
        }
        });
    });
})();
</script>
}

