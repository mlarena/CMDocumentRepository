@model CMDocumentRepository.Application.DTOs.DocumentDto
@{
    var isApprover = ViewBag.IsApprover as bool? ?? false;
    var approvalId = ViewBag.ApprovalId as Guid?;
}

@{
    ViewData["Title"] = $"Документ {Model.DocumentNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>@Model.Title</h4>
    <div>
        @if (!isApprover)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-pencil"></i> Редактировать
            </a>
            @if (!Model.IsDeleted)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Переместить в корзину?')">
                        <i class="bi bi-trash"></i> Удалить
                    </button>
                </form>
            }
            else
            {
                <form asp-action="Restore" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-success">
                        <i class="bi bi-arrow-counterclockwise"></i> Восстановить
                    </button>
                </form>
            }
        }
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Информация о документе</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Номер:</dt>
                    <dd class="col-sm-9"><code>@Model.DocumentNumber</code></dd>

                    <dt class="col-sm-3">Название:</dt>
                    <dd class="col-sm-9">@Model.Title</dd>

                    <dt class="col-sm-3">Описание:</dt>
                    <dd class="col-sm-9">@(Model.Description ?? "—")</dd>

                    <dt class="col-sm-3">Тип:</dt>
                    <dd class="col-sm-9">@Model.DocumentTypeName</dd>

                    <dt class="col-sm-3">Категория:</dt>
                    <dd class="col-sm-9">@Model.CategoryName</dd>

                    <dt class="col-sm-3">Версия:</dt>
                    <dd class="col-sm-9">@Model.Version.ToString("F1")</dd>

                    <dt class="col-sm-3">Статус:</dt>
                    <dd class="col-sm-9">
                        @switch (Model.Status)
                        {
                            case CMDocumentRepository.Domain.Enums.DocumentStatus.Draft:
                                <span class="badge bg-secondary">Черновик</span>
                                break;
                            case CMDocumentRepository.Domain.Enums.DocumentStatus.PendingApproval:
                                <span class="badge bg-warning text-dark">На согласовании</span>
                                break;
                            case CMDocumentRepository.Domain.Enums.DocumentStatus.Approved:
                                <span class="badge bg-success">Согласован</span>
                                break;
                            case CMDocumentRepository.Domain.Enums.DocumentStatus.Rejected:
                                <span class="badge bg-danger">Отклонён</span>
                                break;
                            case CMDocumentRepository.Domain.Enums.DocumentStatus.Rework:
                                <span class="badge bg-info">На доработке</span>
                                break;
                            case CMDocumentRepository.Domain.Enums.DocumentStatus.Active:
                                <span class="badge bg-primary">Действует</span>
                                break;
                            case CMDocumentRepository.Domain.Enums.DocumentStatus.Archived:
                                <span class="badge bg-dark">Архив</span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-3">Автор:</dt>
                    <dd class="col-sm-9">@Model.CreatorName</dd>

                    <dt class="col-sm-3">Дата создания:</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <dt class="col-sm-3">Дата обновления:</dt>
                        <dd class="col-sm-9">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                    }

                    @if (Model.ValidFrom.HasValue || Model.ValidUntil.HasValue)
                    {
                        <dt class="col-sm-3">Срок действия:</dt>
                        <dd class="col-sm-9">
                            @(Model.ValidFrom?.ToString("dd.MM.yyyy") ?? "—") — @(Model.ValidUntil?.ToString("dd.MM.yyyy") ?? "—")
                        </dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.FileExtension))
                    {
                        <dt class="col-sm-3">Файл:</dt>
                        <dd class="col-sm-9">
                            <i class="bi bi-file-earmark"></i> @Model.FileExtension.ToUpper() (@(Model.FileSize / 1024) КБ)
                            <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary ms-2">
                                <i class="bi bi-download"></i> Скачать
                            </a>
                        </dd>
                    }

                    @if (Model.Status == CMDocumentRepository.Domain.Enums.DocumentStatus.Rejected && ViewBag.RejectionComment != null)
                    {
                        <dt class="col-sm-3">Причина отклонения:</dt>
                        <dd class="col-sm-9">
                            <div class="alert alert-danger mb-0">
                                <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.RejectionComment
                            </div>
                        </dd>
                    }
                </dl>
            </div>
        </div>

        @if (ViewBag.Versions != null)
        {
            var versions = (List<CMDocumentRepository.Application.DTOs.DocumentVersionDto>)ViewBag.Versions;
            if (versions.Any())
            {
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">История версий</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Версия</th>
                                        <th>Имя файла</th>
                                        <th>Размер</th>
                                        <th>Дата</th>
                                        <th>Автор</th>
                                        <th>Комментарий</th>
                                        <th>Действие</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in versions)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge @(v.IsMajorVersion ? "bg-primary" : "bg-secondary")">
                                                    @v.VersionNumber.ToString("F1")
                                                </span>
                                                @if (v.IsMajorVersion)
                                                {
                                                    <small class="text-muted"> (мажорная)</small>
                                                }
                                            </td>
                                            <td>
                                                <i class="bi bi-file-earmark"></i>
                                                @(v.FileName ?? "—")
                                            </td>
                                            <td>@(v.FileSize / 1024) КБ</td>
                                            <td>@v.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>@v.CreatorName</td>
                                            <td>@(v.ChangeComment ?? "—")</td>
                                            <td>
                                                <a asp-action="DownloadVersion" asp-route-documentId="@Model.Id" asp-route-versionNumber="@v.VersionNumber" class="btn btn-sm btn-outline-secondary" title="Скачать версию">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Действия</h5>
            </div>
            <div class="card-body">
                @if (Model.Status == CMDocumentRepository.Domain.Enums.DocumentStatus.Draft ||
                      Model.Status == CMDocumentRepository.Domain.Enums.DocumentStatus.Rework)
                {
                    <button type="button" class="btn btn-warning w-100 mb-2" data-bs-toggle="modal" data-bs-target="#approvalModal">
                        <i class="bi bi-send"></i> Отправить на согласование
                    </button>
                }
                @if (Model.Status == CMDocumentRepository.Domain.Enums.DocumentStatus.PendingApproval && isApprover && approvalId.HasValue)
                {
                    <button type="button" class="btn btn-success w-100 mb-2" data-bs-toggle="modal" data-bs-target="#approveModal">
                        <i class="bi bi-check-circle"></i> Согласовать
                    </button>
                    <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#rejectModal">
                        <i class="bi bi-x-circle"></i> Отклонить
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно выбора согласующих -->
<div class="modal fade" id="approvalModal" tabindex="-1" aria-labelledby="approvalModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="approvalModalLabel">
                    <i class="bi bi-send-check me-2"></i>Отправить на согласование
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Approval" asp-action="SendForApproval" method="post">
                <input type="hidden" name="documentId" value="@Model.Id" />
                <div class="modal-body">
                    <p class="text-muted small">Выберите пользователей, которые должны согласовать документ:</p>
                    <div class="mb-3">
                        <label class="form-label">Согласующие:</label>
                        <select name="approverIds" class="form-select" multiple size="8">
                            @if (ViewBag.Approvers != null)
                            {
                                foreach (var approver in (List<CMDocumentRepository.Application.DTOs.UserDto>)ViewBag.Approvers)
                                {
                                    <option value="@approver.Id">
                                        @approver.LastName @approver.FirstName @approver.MiddleName (@approver.UserName)
                                    </option>
                                }
                            }
                        </select>
                        <small class="text-muted">Удерживайте Ctrl для выбора нескольких</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-send me-1"></i>Отправить
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Модальное окно согласования -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="approveModalLabel">
                    <i class="bi bi-check-circle me-2"></i>Согласовать документ
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Approval" asp-action="Approve" method="post">
                <input type="hidden" name="approvalId" value="@approvalId" />
                <div class="modal-body">
                    <p class="text-muted small">Подтвердите согласование документа.</p>
                    <div class="mb-3">
                        <label class="form-label">Комментарий (необязательно):</label>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Введите комментарий..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check me-1"></i>Согласовать
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Модальное окно отклонения -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rejectModalLabel">
                    <i class="bi bi-x-circle me-2"></i>Отклонить документ
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Approval" asp-action="Reject" method="post">
                <input type="hidden" name="approvalId" value="@approvalId" />
                <div class="modal-body">
                    <p class="text-danger small"><i class="bi bi-exclamation-triangle me-1"></i>Обязательно укажите причину отклонения:</p>
                    <div class="mb-3">
                        <label class="form-label">Причина отклонения *</label>
                        <textarea name="comment" class="form-control" rows="3" required placeholder="Укажите причину отклонения..."></textarea>
                        <div class="invalid-feedback">Пожалуйста, укажите причину отклонения.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x me-1"></i>Отклонить
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
