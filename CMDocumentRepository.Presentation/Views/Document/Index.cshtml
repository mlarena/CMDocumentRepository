@model List<CMDocumentRepository.Application.DTOs.DocumentDto>

@{
    ViewData["Title"] = "Документы";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Документы</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Создать документ
    </a>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Номер</th>
                    <th>Название</th>
                    <th>Тип</th>
                    <th>Категория</th>
                    <th>Версия</th>
                    <th>Статус</th>
                    <th>Дата создания</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in Model)
                {
                    <tr>
                        <td><code>@doc.DocumentNumber</code></td>
                        <td>@doc.Title</td>
                        <td>@doc.DocumentTypeName</td>
                        <td>@doc.CategoryName</td>
                        <td>@doc.Version.ToString("F1")</td>
                        <td>
                            @switch (doc.Status)
                            {
                                case CMDocumentRepository.Domain.Enums.DocumentStatus.Draft:
                                    <span class="badge bg-secondary">Черновик</span>
                                    break;
                                case CMDocumentRepository.Domain.Enums.DocumentStatus.PendingApproval:
                                    <span class="badge bg-warning text-dark">На согласовании</span>
                                    break;
                                case CMDocumentRepository.Domain.Enums.DocumentStatus.Approved:
                                    <span class="badge bg-success">Согласован</span>
                                    break;
                                case CMDocumentRepository.Domain.Enums.DocumentStatus.Rejected:
                                    <span class="badge bg-danger">Отклонён</span>
                                    break;
                                case CMDocumentRepository.Domain.Enums.DocumentStatus.Rework:
                                    <span class="badge bg-info">На доработке</span>
                                    break;
                                case CMDocumentRepository.Domain.Enums.DocumentStatus.Active:
                                    <span class="badge bg-primary">Действует</span>
                                    break;
                                case CMDocumentRepository.Domain.Enums.DocumentStatus.Archived:
                                    <span class="badge bg-dark">Архив</span>
                                    break;
                            }
                        </td>
                        <td>@doc.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Документы не найдены
    </div>
}
