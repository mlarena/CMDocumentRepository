@model List<CMDocumentRepository.Application.DTOs.UserDto>

@{
    ViewData["Title"] = "Пользователи";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Пользователи</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Создать пользователя
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>Логин</th>
                <th>Имя</th>
                <th>Email</th>
                <th>Роль</th>
                <th>Статус</th>
                <th>Дата создания</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td><code>@user.UserName</code></td>
                    <td>@user.LastName @user.FirstName</td>
                    <td>@user.Email</td>
                    <td>
                        @switch (user.Role)
                        {
                            case UserRole.SuperAdmin:
                                <span class="badge bg-danger">Суперадмин</span>
                                break;
                            case UserRole.Admin:
                                <span class="badge bg-warning text-dark">Админ</span>
                                break;
                            case UserRole.Manager:
                                <span class="badge bg-info">Менеджер</span>
                                break;
                            case UserRole.User:
                                <span class="badge bg-primary">Пользователь</span>
                                break;
                            case UserRole.Auditor:
                                <span class="badge bg-secondary">Аудитор</span>
                                break;
                            case UserRole.Guest:
                                <span class="badge bg-light text-dark">Гость</span>
                                break;
                        }
                    </td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Активен</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Неактивен</span>
                        }
                    </td>
                    <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
