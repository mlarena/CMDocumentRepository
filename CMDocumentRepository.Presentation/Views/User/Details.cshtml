@model CMDocumentRepository.Application.DTOs.UserDto

@{
    ViewData["Title"] = $"Пользователь {Model.UserName}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>@Model.LastName @Model.FirstName @Model.MiddleName</h4>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil"></i> Редактировать
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Основная информация</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Логин:</dt>
                    <dd class="col-sm-8"><code>@Model.UserName</code></dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Роль:</dt>
                    <dd class="col-sm-8">
                        @switch (Model.Role)
                        {
                            case UserRole.SuperAdmin:
                                <span class="badge bg-danger">Суперадмин</span>
                                break;
                            case UserRole.Admin:
                                <span class="badge bg-warning text-dark">Админ</span>
                                break;
                            case UserRole.Manager:
                                <span class="badge bg-info">Менеджер</span>
                                break;
                            case UserRole.User:
                                <span class="badge bg-primary">Пользователь</span>
                                break;
                            case UserRole.Auditor:
                                <span class="badge bg-secondary">Аудитор</span>
                                break;
                            case UserRole.Guest:
                                <span class="badge bg-light text-dark">Гость</span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4">Статус:</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Активен</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Неактивен</span>
                        }
                        @if (Model.IsLocked)
                        {
                            <span class="badge bg-warning text-dark">Заблокирован</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Дата создания:</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Действия</h5>
            </div>
            <div class="card-body">
                @if (Model.IsLocked)
                {
                    <form asp-action="ToggleLock" asp-route-id="@Model.Id" asp-route-lock="false" method="post" class="mb-2">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-unlock"></i> Разблокировать
                        </button>
                    </form>
                }
                else
                {
                    <form asp-action="ToggleLock" asp-route-id="@Model.Id" asp-route-lock="true" asp-route-lockMinutes="15" method="post" class="mb-2">
                        <button type="submit" class="btn btn-warning w-100">
                            <i class="bi bi-lock"></i> Заблокировать на 15 мин
                        </button>
                    </form>
                }

                <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" class="mb-2">
                    <div class="input-group">
                        <input type="password" name="newPassword" class="form-control" placeholder="Новый пароль" required />
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-key"></i> Сбросить пароль
                        </button>
                    </div>
                </form>

                @if (Model.Role != UserRole.SuperAdmin)
                {
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Удалить пользователя?')">
                            <i class="bi bi-trash"></i> Удалить
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
