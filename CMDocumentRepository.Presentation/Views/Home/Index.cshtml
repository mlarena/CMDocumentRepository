@{
    ViewData["Title"] = "Главная";
}

<div class="row mb-4">
    <div class="col-12">
        <h2>Добро пожаловать в систему управления документами</h2>
        <p class="text-muted">CMDocumentRepository - корпоративная система электронного документооборота</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card card-stat border-primary">
            <div class="card-body text-center">
                <i class="bi bi-file-earmark-text text-primary" style="font-size: 2rem;"></i>
                <h3 class="mt-2">@(ViewBag.MyDocuments ?? 0)</h3>
                <p class="text-muted mb-0">Мои документы</p>
            </div>
            <a asp-controller="Document" asp-action="MyDocuments" class="card-footer bg-primary text-white text-center text-decoration-none">
                Посмотреть <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stat border-primary">
            <div class="card-body text-center">
                <i class="bi bi-clock text-primary" style="font-size: 2rem;"></i>
                <h3 class="mt-2">@(ViewBag.PendingApprovals ?? 0)</h3>
                <p class="text-muted mb-0">На согласовании</p>
            </div>
            <a asp-controller="Approval" asp-action="Index" class="card-footer bg-primary text-whitecd text-center text-decoration-none">
                Посмотреть <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stat border-primary">
            <div class="card-body text-center">
                <i class="bi bi-kanban text-primary" style="font-size: 2rem;"></i>
                <h3 class="mt-2">@(ViewBag.MyTasks ?? 0)</h3>
                <p class="text-muted mb-0">Мои задачи</p>
            </div>
            <a asp-controller="Task" asp-action="Kanban" class="card-footer bg-primary text-white text-center text-decoration-none">
                Посмотреть <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stat border-primary">
            <div class="card-body text-center">
                <i class="bi bi-search text-primary" style="font-size: 2rem;"></i>
                <h3 class="mt-2">&nbsp;</h3>
                <p class="text-muted mb-0">Поиск документов</p>
            </div>
            <a asp-controller="Search" asp-action="Index" class="card-footer bg-primary text-white text-center text-decoration-none">
                Найти <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Быстрые действия</h5>
            </div>
            <div class="card-body">
                <a asp-controller="Document" asp-action="Create" class="btn btn-outline-primary me-2 mb-2">
                    <i class="bi bi-plus-circle"></i> Новый документ
                </a>
                <a asp-controller="Task" asp-action="Create" class="btn btn-outline-primary me-2 mb-2">
                    <i class="bi bi-plus-circle"></i> Новая задача
                </a>
                <a asp-controller="Search" asp-action="Index" class="btn btn-outline-secondary mb-2">
                    <i class="bi bi-search"></i> Поиск
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Информация</h5>
            </div>
            <div class="card-body">
                <p class="mb-2"><i class="bi bi-primary-circle"></i> Используйте левое меню для навигации</p>
                <p class="mb-2"><i class="bi bi-primary-circle"></i> Документы создаются с автоматической нумерацией</p>
                <p class="mb-0"><i class="bi bi-primary-circle"></i> Версионирование работает автоматически при загрузке новых файлов</p>
            </div>
        </div>
    </div>
</div>
