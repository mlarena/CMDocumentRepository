@model List<CMDocumentRepository.Application.DTOs.DocumentTypeDto>

@{
    ViewData["Title"] = "Типы документов";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Типы документов</h4>
    <a asp-action="CreateDocumentType" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Добавить тип
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>Название</th>
                <th>Код</th>
                <th>Описание</th>
                <th>Системный</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var type in Model)
            {
                <tr>
                    <td>@type.Name</td>
                    <td><code>@type.Code</code></td>
                    <td>@(type.Description ?? "—")</td>
                    <td>
                        @if (type.IsSystem)
                        {
                            <span class="badge bg-secondary">Системный</span>
                        }
                    </td>
                    <td>
                        @if (!type.IsSystem)
                        {
                            <form asp-action="DeleteDocumentType" asp-route-id="@type.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Удалить тип?')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
