@{
    ViewData["Title"] = "Администрирование";
}

<h4>Администрирование системы</h4>
<hr />

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-people text-primary" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Пользователи</h5>
                <p class="text-muted">Управление учётными записями и ролями</p>
            </div>
            <a asp-controller="User" asp-action="Index" class="card-footer bg-primary text-white text-center text-decoration-none">
                Управление <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-tag text-info" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Типы документов</h5>
                <p class="text-muted">Справочник типов документов</p>
            </div>
            <a asp-action="DocumentTypes" class="card-footer bg-info text-white text-center text-decoration-none">
                Управление <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <i class="bi bi-folder text-warning" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Категории</h5>
                <p class="text-muted">Справочник категорий документов</p>
            </div>
            <a asp-action="Categories" class="card-footer bg-warning text-dark text-center text-decoration-none">
                Управление <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>
