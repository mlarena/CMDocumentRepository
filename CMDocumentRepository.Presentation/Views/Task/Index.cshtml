@model List<CMDocumentRepository.Application.DTOs.TaskDto>

@{
    ViewData["Title"] = "Задачи";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Задачи</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Новая задача
    </a>
</div>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Название</th>
                    <th>Приоритет</th>
                    <th>Статус</th>
                    <th>Исполнитель</th>
                    <th>Дедлайн</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model)
                {
                    <tr>
                        <td>@task.Title</td>
                        <td>
                            @switch (task.Priority)
                            {
                                case TaskPriority.Low:
                                    <span class="badge bg-secondary">Низкий</span>
                                    break;
                                case TaskPriority.Medium:
                                    <span class="badge bg-primary">Средний</span>
                                    break;
                                case TaskPriority.High:
                                    <span class="badge bg-warning text-dark">Высокий</span>
                                    break;
                                case TaskPriority.Critical:
                                    <span class="badge bg-danger">Критический</span>
                                    break;
                            }
                        </td>
                        <td>
                            @switch (task.Status)
                            {
                                case AppTaskStatus.Backlog:
                                    <span class="badge bg-secondary">Backlog</span>
                                    break;
                                case AppTaskStatus.InProgress:
                                    <span class="badge bg-primary">В работе</span>
                                    break;
                                case AppTaskStatus.Review:
                                    <span class="badge bg-info">На проверке</span>
                                    break;
                                case AppTaskStatus.Done:
                                    <span class="badge bg-success">Готово</span>
                                    break;
                            }
                        </td>
                        <td>@(task.AssigneeName ?? "Не назначен")</td>
                        <td>@(task.DueDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Задачи не найдены
    </div>
}
