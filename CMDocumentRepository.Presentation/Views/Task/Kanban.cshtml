@model List<CMDocumentRepository.Application.DTOs.TaskDto>

@{
    ViewData["Title"] = "Kanban-доска";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Kanban-доска</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Новая задача
    </a>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="card bg-light">
            <div class="card-header">
                <h6 class="mb-0">Backlog</h6>
            </div>
            <div class="card-body kanban-column" data-status="Backlog" style="min-height: 400px;">
                @foreach (var task in Model.Where(t => t.Status == CMDocumentRepository.Domain.Enums.AppTaskStatus.Backlog))
                {
                    <div class="card mb-2 kanban-card" draggable="true" data-task-id="@task.Id">
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between">
                                <strong class="small">@task.Title</strong>
                                <span class="badge bg-secondary">@task.Priority</span>
                            </div>
                            @if (task.DueDate.HasValue)
                            {
                                <small class="text-muted"><i class="bi bi-calendar"></i> @task.DueDate.Value.ToString("dd.MM")</small>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-light">
            <div class="card-header">
                <h6 class="mb-0">In Progress</h6>
            </div>
            <div class="card-body kanban-column" data-status="InProgress" style="min-height: 400px;">
                @foreach (var task in Model.Where(t => t.Status == CMDocumentRepository.Domain.Enums.AppTaskStatus.InProgress))
                {
                    <div class="card mb-2 kanban-card" draggable="true" data-task-id="@task.Id">
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between">
                                <strong class="small">@task.Title</strong>
                                <span class="badge bg-warning text-dark">@task.Priority</span>
                            </div>
                            @if (task.DueDate.HasValue)
                            {
                                <small class="text-muted"><i class="bi bi-calendar"></i> @task.DueDate.Value.ToString("dd.MM")</small>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-light">
            <div class="card-header">
                <h6 class="mb-0">Review</h6>
            </div>
            <div class="card-body kanban-column" data-status="Review" style="min-height: 400px;">
                @foreach (var task in Model.Where(t => t.Status == CMDocumentRepository.Domain.Enums.AppTaskStatus.Review))
                {
                    <div class="card mb-2 kanban-card" draggable="true" data-task-id="@task.Id">
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between">
                                <strong class="small">@task.Title</strong>
                                <span class="badge bg-info">@task.Priority</span>
                            </div>
                            @if (task.DueDate.HasValue)
                            {
                                <small class="text-muted"><i class="bi bi-calendar"></i> @task.DueDate.Value.ToString("dd.MM")</small>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card bg-light">
            <div class="card-header">
                <h6 class="mb-0">Done</h6>
            </div>
            <div class="card-body kanban-column" data-status="Done" style="min-height: 400px;">
                @foreach (var task in Model.Where(t => t.Status == CMDocumentRepository.Domain.Enums.AppTaskStatus.Done))
                {
                    <div class="card mb-2 kanban-card" draggable="true" data-task-id="@task.Id">
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between">
                                <strong class="small">@task.Title</strong>
                                <span class="badge bg-success">@task.Priority</span>
                            </div>
                            @if (task.DueDate.HasValue)
                            {
                                <small class="text-muted"><i class="bi bi-calendar"></i> @task.DueDate.Value.ToString("dd.MM")</small>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.kanban-card').forEach(card => {
            card.addEventListener('dragstart', function(e) {
                e.dataTransfer.setData('text/plain', this.dataset.taskId);
                this.classList.add('opacity-50');
            });
            card.addEventListener('dragend', function() {
                this.classList.remove('opacity-50');
            });
        });

        document.querySelectorAll('.kanban-column').forEach(column => {
            column.addEventListener('dragover', function(e) {
                e.preventDefault();
                this.classList.add('border-primary');
            });
            column.addEventListener('dragleave', function() {
                this.classList.remove('border-primary');
            });
            column.addEventListener('drop', function(e) {
                e.preventDefault();
                this.classList.remove('border-primary');
                const taskId = e.dataTransfer.getData('text/plain');
                const newStatus = this.dataset.status;

                fetch('/Task/Move', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify({
                        taskId: taskId,
                        newOrder: 0,
                        newStatus: newStatus
                    })
                }).then(() => location.reload());
            });
        });
    </script>
}
